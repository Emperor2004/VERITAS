# =============================================================================
# VERITAS — Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# .env is git-ignored. Never commit real credentials.
# =============================================================================


# -----------------------------------------------------------------------------
# LLM Provider  (Phase 6 — Agentic AI layer)
# -----------------------------------------------------------------------------
# VERITAS supports two LLM backends. Set VERITAS_LLM_PROVIDER to activate one.
# If neither is set, the system runs in deterministic mode: all 5 statistical
# pipeline phases execute normally; only the agentic narration steps are skipped.

# --- Option A: Google Gemini (recommended for demos) ---
# Install: pip install langchain-google-genai>=1.0
# Get your API key at: https://aistudio.google.com/app/apikey
VERITAS_LLM_PROVIDER=gemini
GOOGLE_API_KEY=AIzaSy...your_key_here

# --- Option B: Ollama (local, no API key required) ---
# Install Ollama from: https://ollama.com  then: ollama pull llama3.2
# Install: pip install langchain-ollama>=0.1
# VERITAS_LLM_PROVIDER=ollama
# OLLAMA_BASE_URL=http://localhost:11434

# --- Shared LLM tuning (optional, applies to both providers) ---
# VERITAS_LLM_MODEL=gemini-3.8-flash   # default for Gemini
# VERITAS_LLM_MODEL=llama3.2           # default for Ollama
# VERITAS_LLM_TEMPERATURE=0.0          # 0.0 = deterministic outputs (recommended for auditing)


# -----------------------------------------------------------------------------
# FastAPI Backend & Production Deployment
# -----------------------------------------------------------------------------
# Server binding & worker concurrency (Docker / Production)
# PORT=8000
# WORKERS=2
# BACKEND_PORT=8000
# FRONTEND_PORT=3000

# CORS origins (comma-separated list for production deployment domains)
# Defaults to "http://localhost:3000,http://127.0.0.1:3000" if unset
# VERITAS_CORS_ORIGINS=http://localhost:3000,https://veritas.yourdomain.com

# SQLite database paths — defaults work out of the box; only override if you
# need to store data in a custom location (e.g., Docker volume or network drive).
# VERITAS_DB_PATH=outputs/api_data/veritas_runs.sqlite
# VERITAS_CHECKPOINT_DB_PATH=outputs/api_data/checkpoints.sqlite


# -----------------------------------------------------------------------------
# Quick-start defaults
# -----------------------------------------------------------------------------
# With Gemini:
#   1. Set GOOGLE_API_KEY above
#   2. pip install langchain-google-genai
#   3. uvicorn api.main:app --host 127.0.0.1 --port 8000 --reload
#   4. cd frontend && npm run dev
#   5. Open http://localhost:3000
#
# Without any LLM (deterministic mode only):
#   1. Comment out VERITAS_LLM_PROVIDER above (or leave file empty)
#   2. Start both servers as above — the web app still runs fully;
#      agentic narration cards will show "Deterministic mode" placeholders.
