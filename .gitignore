# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/

# --- Virtual environment ---
.venv/
venv/
env/

# --- Environment variables / secrets ---
.env
*.env.local

# --- Data (large / regenerable / should not be versioned) ---
data/raw/*
data/processed/*
data/synthetic_logs/*
!data/raw/.gitkeep
!data/processed/.gitkeep
!data/synthetic_logs/.gitkeep

# --- Pipeline outputs (regenerated by running the pipeline) ---
outputs/logs/*
outputs/reports/*
!outputs/logs/.gitkeep
!outputs/reports/.gitkeep

# --- IDE / editor ---
.vscode/
.idea/
*.swp
*.swo

# --- OS ---
.DS_Store
Thumbs.db

# --- Testing / coverage ---
.pytest_cache/
.coverage
htmlcov/

# --- Jupyter (if used for exploration) ---
.ipynb_checkpoints/