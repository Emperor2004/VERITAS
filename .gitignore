# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
*.egg

# --- Virtual environment ---
.venv/
venv/
env/
ENV/

# --- Environment variables / secrets ---
.env
*.env.local
.env*.local

# --- Frontend (Node.js & Next.js) ---
frontend/node_modules/
frontend/.next/
frontend/out/
frontend/.turbo/
node_modules/
.next/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-debug.log*
.vercel/

# --- SQLite Databases & Checkpoints ---
*.sqlite
*.sqlite3
*.sqlite-shm
*.sqlite-wal
*.db
!*.sql

# --- Data (large / regenerable / should not be versioned) ---
data/raw/*
data/processed/*
data/synthetic_logs/*
!data/raw/.gitkeep
!data/processed/.gitkeep
!data/synthetic_logs/.gitkeep
!data/demo_audit_dataset.csv

# --- Pipeline outputs (regenerated by running the pipeline) ---
outputs/logs/*
outputs/reports/*
outputs/api_data/*
!outputs/logs/.gitkeep
!outputs/reports/.gitkeep
!outputs/api_data/.gitkeep

# --- IDE / editor ---
.vscode/
.idea/
*.swp
*.swo
*~

# --- OS ---
.DS_Store
Thumbs.db
Desktop.ini
ehthumbs.db

# --- Testing / coverage ---
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/

# --- Jupyter ---
.ipynb_checkpoints/

# --- Tool-specific ---
.kilo/

# --- Misc generated files ---
*.log